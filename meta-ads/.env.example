# Copy this file to `.env` and fill in your real values.
# The real `.env` is gitignored — NEVER commit it, it holds your access token.

# System User / long-lived access token with `ads_management` permission.
# Generate at: business.facebook.com → Business Settings → Users → System Users
# → Generate Token → select your app → scopes: ads_management, business_management
META_ACCESS_TOKEN=

# Your ad account id — the number after "act_" (Ads Manager → top-left account picker)
META_AD_ACCOUNT_ID=act_1234567890

# Your Facebook Page id (Page → About → Page transparency, or Business Settings → Pages)
META_PAGE_ID=

# WhatsApp number connected to the Page, digits only, with country code
META_WHATSAPP_NUMBER=918448222454

# Path (relative to this folder) to the ad image — 1080x1080 or 1080x1350 recommended
IMAGE_PATH=creative.jpg

# Optional
DAILY_BUDGET_INR=2500
META_API_VERSION=v23.0
